# =====================================================================
# ClaimVault — Production Environment Configuration (.env.example)
# =====================================================================

# Server Port
PORT=5000
NODE_ENV=production

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_signing_key_claimvault_pk_2026
JWT_EXPIRES_IN=30d

# Signed URLs Security
SIGNED_URL_SECRET=your_signed_url_hmac_secret_2026
SIGNED_URL_EXPIRY_SECONDS=900

# PostgreSQL Database
DATABASE_URL=postgresql://claimvault_admin:your_secure_password@localhost:5432/claimvault_db?sslmode=require

# AWS S3 / Cloud Object Storage
S3_BUCKET_NAME=claimvault-production-vault
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_UPLOADS=20
